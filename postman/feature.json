{
  "info": {
    "_postman_id": "ewm-full-merged",
    "name": "Explore With Me - FULL FEATURE (merged)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "function pad(v){return String(v).padStart(2,'0');}",
          "function fmt(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+' '+pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());}",
          "pm.collectionVariables.set('futureEventDate', fmt(new Date(now.getTime()+3*3600000)));",
          "pm.collectionVariables.set('futureRejectedEventDate', fmt(new Date(now.getTime()+4*3600000)));",
          "pm.collectionVariables.set('futureUpdatedEventDate', fmt(new Date(now.getTime()+5*3600000)));"
        ]
      }
    }
  ],

  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],

  "item": [

    {
      "name": "01 - LOCATION MODULE",
      "item": [
        {
          "name": "Create admin user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', ()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('adminUserId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Location Admin\",\n  \"email\": \"location-admin@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin","users"]
            }
          }
        },

        {
          "name": "Create location",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', ()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('locationId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 56.9496,\n  \"lon\": 24.1052\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/locations",
              "host": ["{{baseUrl}}"],
              "path": ["admin","locations"]
            }
          }
        },

        {
          "name": "Get locations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', ()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/locations?from=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin","locations"],
              "query": [
                {"key":"from","value":"0"},
                {"key":"size","value":"10"}
              ]
            }
          }
        },

        {
          "name": "Get location by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', ()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/locations/{{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin","locations","{{locationId}}"]
            }
          }
        },

        {
          "name": "Update location",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', ()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 59.4370,\n  \"lon\": 24.7536\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/locations/{{locationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin","locations","{{locationId}}"]
            }
          }
        }
      ]
    },

