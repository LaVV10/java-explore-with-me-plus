{
  "info": {
    "name": "Main API",
    "_postman_id": "b7c1d2a1-1111-2222-3333-abcdefabcdef",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "eventId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Public Events",
      "item": [
        {
          "name": "Get Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events"
          }
        },
        {
          "name": "Get Event By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "Private Events",
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test event\",\n  \"description\": \"desc\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/events"
          }
        },
        {
          "name": "Get User Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}/events"
          }
        },
        {
          "name": "Get User Event By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}/events/{{eventId}}"
          }
        },
        {
          "name": "Update Event By User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"updated\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/events/{{eventId}}"
          }
        },
        {
          "name": "Get Event Requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}/events/{{eventId}}/requests"
          }
        },
        {
          "name": "Update Requests",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/events/{{eventId}}/requests"
          }
        }
      ]
    },
    {
      "name": "Comments (PRIVATE)",
      "item": [
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"my comment\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/comments/{{eventId}}"
          }
        },
        {
          "name": "Get User Comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}/comments?from=0&size=10"
          }
        },
        {
          "name": "Get Comment By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Update Comment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"updated comment\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "Comments (ADMIN)",
      "item": [
        {
          "name": "Get Comments By Event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/comments?eventId={{eventId}}"
          }
        },
        {
          "name": "Get Comment By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/comments/{{commentId}}"
          }
        },
        {
          "name": "Update Comment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"admin update\"\n}"
            },
            "url": "{{baseUrl}}/admin/comments/{{commentId}}"
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "Admin Events",
      "item": [
        {
          "name": "Update Event",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"admin update\"\n}"
            },
            "url": "{{baseUrl}}/admin/events/{{eventId}}"
          }
        },
        {
          "name": "Publish Event",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/events/{{eventId}}/publish"
          }
        },
        {
          "name": "Reject Event",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/events/{{eventId}}/reject"
          }
        },
        {
          "name": "Get Pending Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/events/pending?from=0&size=10"
          }
        },
        {
          "name": "Get Events (Admin Filter)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/events"
          }
        }
      ]
    }
  ]
}